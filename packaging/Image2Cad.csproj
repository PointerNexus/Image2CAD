<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Image2Cad</RootNamespace>
    <AssemblyName>Image2CAD</AssemblyName>

    <!-- Single self-contained exe: the .NET runtime travels with the app so the
         file works on any Windows 10/11 machine with no prerequisites. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Window and Explorer icon: dark tile, cyan CAD polyline, vertex nodes. -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The page is embedded from the repository root so there is exactly one
         copy of the app in the tree. Editing ../image2cad.html and rebuilding
         is all it takes to refresh the exe. -->
    <EmbeddedResource Include="..\image2cad.html" LogicalName="Image2Cad.app.image2cad.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

</Project>
